    [#판정(Q2("Q-경계2 거칠기").통과)],
    [IoU(128 · 192, 양쪽 채움) D′ ≥ A − 0.005],
    [격자 128 #부호(Q2("Q-경계3 형상").at("128")) · 격자 192 #부호(Q2("Q-경계3 형상").at("192"))],
    [#판정(Q2("Q-경계3 형상").통과)],
    [해상도 대조 \> 0.1],
    [중앙 #부호(Q2("Q-경계4 격자 회피").중앙)],
    [#판정(Q2("Q-경계4 격자 회피").통과)],
    [동일 부피 대조군이 초과를 지불],
    [초과 B⁺ − D′ 중앙 #부호(Q2("Q-대조 B⁺").at("넘침(B⁺)−넘침(D′) 중앙"), d: 4) · 미피복 B⁺ #수(Q2("Q-대조 B⁺").at("못덮음(B⁺) 중앙"), d: 4) 대 D′ #수(Q2("Q-대조 B⁺").at("못덮음(D′) 중앙"), d: 4)],
    [#판정(Q2("Q-대조 B⁺").통과)],
