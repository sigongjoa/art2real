    [중앙 #부호(Q2("Q-경계1 못덮음").at("D′−A 중앙"), d: 4) · D′ 가 D 보다 나은 사례 #Q2("Q-경계1 못덮음").at("D′<D 인 장")/#판2.n · 앞 바퀴 D − A 는 #부호(Q2("Q-경계1 못덮음").at("어제 D−A"), d: 4)],
    [#판정(Q2("Q-경계1 못덮음").통과)],
